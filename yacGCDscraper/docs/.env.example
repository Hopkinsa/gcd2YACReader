# Copy these values into your shell environment before starting the app.
# All paths should be absolute paths on your machine.

# Path to the YACReader library SQLite database.
YAC_GCD_LIBRARY_PATH=/path/to/yacreaderlibrary/library.ydb

# Path to the directory containing cover JPEGs named <hash>.jpg.
YAC_GCD_COVERS_PATH=/path/to/yacreaderlibrary/covers

# Path to the Grand Comics Database SQLite export.
YAC_GCD_DATABASE_PATH=/path/to/gcd.sqlite